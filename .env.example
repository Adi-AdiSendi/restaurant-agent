# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant
OPENAI_API_KEY=
# Confirm the exact model ID in the OpenAI dashboard.
OPENAI_MODEL=gpt-6-luna
# Long random string used to sign session cookies. Required in production
# (32+ characters). Empty in development means a random secret per run.
SESSION_SECRET=
# Optional. Folder with the built frontend. Defaults to frontend/dist in the repo.
# FRONTEND_DIST=
